<dialog id="lightbox" aria-label="Fotoğraf önizleme">
  <div class="lightbox-toolbar">
    <span id="lightbox-count"></span>
    <button id="lightbox-close" aria-label="Önizlemeyi kapat">
      Kapat ×
    </button>
  </div>
  <img id="lightbox-image" alt="" />
  <div class="lightbox-controls">
    <button id="lightbox-prev" aria-label="Önceki fotoğraf">
      ← Önceki
    </button>
    <p id="lightbox-caption"></p>
    <button id="lightbox-next" aria-label="Sonraki fotoğraf">
      Sonraki →
    </button>
  </div>
</dialog>
