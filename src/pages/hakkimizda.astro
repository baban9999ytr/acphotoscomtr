---
import Layout from "../layouts/Layout.astro";
import { fixtures } from "../lib/fixtures";
import { buildContent } from "../lib/build-content";
const previewMode = (await buildContent()).source !== "supabase";
---

<Layout title="Hakkımızda">
  <section class="wrap section">
    <div class="page-intro">
      <h1 data-photographer-name>
        {fixtures.site_settings[0]!.photographer_name}
      </h1>
      <p>Fotoğrafçı</p>
    </div>
    <div class="about-layout">
      <figure class="about-photo" data-preview-visual hidden={!previewMode}>
        <img
          src="/demo/photographer-1000.webp"
          width="1000"
          height="1250"
          alt="Saha kenarında çalışan kimliği belirtilmeyen fotoğrafçı; demo görsel, Arda Cesurtürk'ün fotoğrafı değildir"
        />
        <figcaption>
          Örnek görsel · Arda Cesurtürk'ün fotoğrafı değildir
        </figcaption>
      </figure>
      <div>
        <h2>
          Oyunun içinden
          <br />
          kareler.
        </h2>
        <p data-photographer-bio>
          {fixtures.site_settings[0]!.photographer_bio}
        </p>
        <a class="text-link" href="/iletisim/">
          İletişime geç ↗
        </a>
      </div>
    </div>
  </section>
  <script>
    import "../scripts/public";
  </script>
</Layout>
