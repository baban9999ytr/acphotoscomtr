---
import Layout from "../layouts/Layout.astro";
import { demoMode } from "../lib/model";
import { fixtures } from "../lib/fixtures";
---

<Layout title="Hakkımızda">
  <section class="wrap section">
    <div class="page-intro">
      <h1 data-photographer-name>
        {fixtures.site_settings[0]!.photographer_name}
      </h1>
      <p>Fotoğrafçı · Bursa</p>
    </div>
    <div class="about-layout">
      {demoMode && (
        <img
          src="/demo/photo-2-1000.webp"
          width="1000"
          height="667"
          alt="Dağlar arasında bir göl; örnek fotoğraf"
        />
      )}
      <div>
        <h2>
          Sahadan
          <br />
          anlatılan hikâyeler.
        </h2>
        <p data-photographer-bio>
          {fixtures.site_settings[0]!.photographer_bio}
        </p>
        <a class="text-link" href="/iletisim/">
          İletişime geç ↗
        </a>
      </div>
    </div>
  </section>
  <script>
    import "../scripts/public";
  </script>
</Layout>
