---
import Layout from "../layouts/Layout.astro";
import { fixtures } from "../lib/fixtures";
import { buildContent } from "../lib/build-content";
import { contentConfig } from "../lib/model";
const previewMode = (await buildContent()).source !== "supabase";
const contactFormEnabled = contentConfig.mode === "supabase";
const settings = fixtures.site_settings[0]!;
const phoneLabel = "+90 531 517 28 42";
const instagramName = settings.instagram
  .replace(/^https:\/\/(www\.)?instagram\.com\//, "@")
  .replace(/\/$/, "");
---

<Layout title="İletişim">
  <section class="contact-page wrap section">
    <header class="contact-heading">
      <div>
        <span class="eyebrow">İletişim</span>
        <h1>Yeni bir hikâye<br />bir selamla başlar.</h1>
      </div>
      <p>
        Fotoğrafçı Arda Cesurtürk’e ulaşın. Maçlar, portreler ve birlikte
        anlatabileceğimiz hikâyeler için yazın.
      </p>
    </header>

    <div class="contact-layout">
      <div class="contact-details" data-contact>
        <span class="eyebrow">Arda Cesurtürk · Fotoğrafçı</span>
        <h2>Konuşalım.</h2>
        <p class="contact-note">
          Projenizi veya etkinliğinizi kısaca anlatın; size en uygun kanaldan
          ulaşabilirsiniz.
        </p>
        <div class="contact-methods">
          <a class="contact-method" href={`mailto:${settings.email}`}>
            <span class="contact-method-copy">
              <span class="contact-method-label">E-posta</span>
              <span class="contact-method-value">{settings.email}</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="contact-method" href={`tel:${settings.phone}`}>
            <span class="contact-method-copy">
              <span class="contact-method-label">Telefon</span>
              <span class="contact-method-value">{phoneLabel}</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>
          <a
            class="contact-method"
            href="https://wa.me/905315172842"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-method-copy">
              <span class="contact-method-label">WhatsApp</span>
              <span class="contact-method-value">Mesaj gönderin</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>
          <a
            class="contact-method"
            href={settings.instagram}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="contact-method-copy">
              <span class="contact-method-label">Instagram</span>
              <span class="contact-method-value">{instagramName}</span>
            </span>
            <span class="contact-method-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <a class="contact-albums-link" href="/albumler/">
          Albümleri keşfedin <span aria-hidden="true">↗</span>
        </a>
      </div>

      <figure class="contact-photo" data-preview-visual hidden={!previewMode}>
        <img
          src="/demo/tribune-1800.webp"
          width="1672"
          height="941"
          alt="Akşam ışığında tribün ve saha; yapay zekâ ile oluşturulmuş demo fotoğraf"
        />
        <figcaption>
          Tribünden sahaya, her karşılaşmanın bir hikâyesi var. · Örnek görsel
        </figcaption>
      </figure>
    </div>

    <section class="contact-form-section" aria-labelledby="contact-form-title">
      <div class="contact-form-intro">
        <span class="eyebrow">Kısa bir not</span>
        <h2 id="contact-form-title">Size nasıl yardımcı olabiliriz?</h2>
        <p>
          Adınızı, e-posta adresinizi ve mesajınızı bırakın. Yanıt için verdiğiniz
          e-posta adresi kullanılacaktır.
        </p>
      </div>
      <form class="contact-form" data-contact-form>
        <div class="contact-form-fields">
          <label>
            Adınız
            <input
              name="name"
              type="text"
              autocomplete="name"
              minlength="2"
              maxlength="100"
              required
            />
          </label>
          <label>
            E-posta adresiniz
            <input
              name="email"
              type="email"
              autocomplete="email"
              maxlength="254"
              required
            />
          </label>
          <label class="contact-message-field">
            Mesajınız
            <textarea name="message" rows="4" minlength="10" maxlength="4000" required></textarea>
          </label>
        </div>
        <div class="contact-honeypot" aria-hidden="true">
          <label>
            Web sitesi
            <input name="website" type="text" tabindex="-1" autocomplete="off" />
          </label>
        </div>
        <div class="contact-form-footer">
          <p
            class="contact-form-note"
            id="contact-form-note"
            data-contact-form-note
          >
            {!contactFormEnabled
              ? "Demo Modu: Supabase yapılandırıldığında form gönderimi etkinleşir."
              : "Mesajınız ACPhotos’un Supabase veritabanına güvenli biçimde iletilir."}
          </p>
          <button class="contact-submit" type="submit" disabled={!contactFormEnabled}>
            Mesajı gönder <span aria-hidden="true">↗</span>
          </button>
        </div>
        <p
          class="contact-form-status"
          data-contact-form-status
          id="contact-form-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        ></p>
      </form>
    </section>
  </section>
  <script>
    import "../scripts/public";
    import "../scripts/contact-form";
  </script>
</Layout>
